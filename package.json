{
  "name": "health",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" npm run payload:migrate && next build",
    "build:vercel": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" npm run payload:migrate && npm run generate:types && next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "payload:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload:migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "payload:migrate:fresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:fresh",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@lexical/selection": "0.50.0",
    "@lexical/utils": "0.50.0",
    "@payloadcms/db-vercel-postgres": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lexical": "0.50.0",
    "lucide-react": "^0.469.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.5.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.5.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "26.1.0",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "@babel/core@7": "^7.29.6",
      "@humanfs/node@0": "^0.16.8",
      "ajv@6": "^6.14.0",
      "ajv@8": "^8.18.0",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "browserslist@4": "^4.28.7",
      "fast-uri@3": "^3.1.8",
      "flatted@3": "^3.4.2",
      "glob@10": "^10.5.0",
      "immutable@4": "^4.3.9",
      "js-yaml@4": "^4.3.2",
      "lodash@4": "^4.18.0",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "nanoid@3": "^3.3.18",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss-selector-parser@6": "^6.1.3",
      "postcss@8": "^8.5.23",
      "rollup@4": "^4.59.0",
      "undici@7": "^7.29.1",
      "vite@7": "^7.3.6",
      "ws@8": "^8.21.0",
      "yaml@1": "^1.10.3",
      "yaml@2": "^2.8.3"
    }
  },
  "overrides": {
    "payload": "3.90.2",
    "@payloadcms/*": "3.90.2",
    "@lexical/*": "0.50.0",
    "lexical": "0.50.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
