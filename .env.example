PAYLOAD_SECRET=YOUR_SECRET_HERE
DATABASE_URL=postgres://{user}:{password}@{hostname}:{port}/{database-name}

POSTGRES_URL=123
NEXT_PUBLIC_SITE_URL=https://localhost:3000
BLOB_READ_WRITE_TOKEN=123-token
REVALIDATION_SECRET=123-token
NEXT_PUBLIC_SEMBLE_TOKEN=semble-token

RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Health
FORM_NOTIFICATION_EMAIL=admin@yourdomain.com
# Forms: set NEXT_PUBLIC_FORMS_ENABLED=true to go live; until then open a page with ?forms-preview=<FORMS_PREVIEW_TOKEN> to test
NEXT_PUBLIC_FORMS_ENABLED=false
FORMS_PREVIEW_TOKEN=generate-a-long-random-string
# Cloudflare Turnstile (form spam protection). These are Cloudflare's always-pass test keys for local use;
# production must set real keys (submissions are rejected in production if the secret is missing)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
